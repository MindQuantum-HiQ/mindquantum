---
/*
 * Features — the "Core capabilities" band of the home page.
 *
 * Inspiration: the MindQuantum whitepaper's "Elements of MindSpore Quantum"
 * figure (intro chapter) and the chapter list that follows. The paper carves
 * the framework into a small set of named blocks, each with a tight bullet
 * list of concrete components ("Quantum Gate · Quantum Circuit · Parameter
 * Resolver · Observable"). We borrow that shape directly: a four-pillar
 * editorial spec sheet where typography and component names carry the proof,
 * not decorative imagery.
 *
 * Why no images:
 *   - The previous version mounted hand-authored SVG diagrams inside framed
 *     cards. They read as code-generated decoration (an explicit anti-ref
 *     in PRODUCT.md) and the surrounding card chrome looked like the SaaS
 *     "icon-title-paragraph" template the brief rejects.
 *   - The 3D-render JPEGs that lived in src/assets/home/ were AI-startup
 *     aesthetic (glowing isometric microchips), also banned.
 *   - Per the user's instruction, no images are better than rough ones.
 *
 * Layout strategy:
 *   - Asymmetric header: eyebrow + h2 on the left, lead sentence on the
 *     right (12-col grid, 5/6 split), breaking the centered-stack template.
 *   - 2×2 body grid with NO card chrome (no border, no fill, no rounded
 *     background). Just typographic blocks separated by generous whitespace
 *     and a single hairline rule at the top to anchor the section.
 *   - Each pillar uses an internal hierarchy that maps onto the whitepaper's
 *     chapter format: small mono numeral, bold title, prose, mono keyword
 *     list closing the block.
 */

import type { HomeMessages } from "../../locales/home";

interface Props {
  features: HomeMessages["features"];
}

const { features } = Astro.props as Props;
---

<section class="mq-container mb-20 lg:mb-24">
  {/* Section header — asymmetric, eyebrow + display title on the left,
      a single-sentence lead on the right. Both columns sit at the baseline
      of the heading so the lead reads as caption to the heading rather
      than as a separate block.

      Heading takes 6 of 12 columns (not 5) so the longest title variants
      — including the Chinese "用户友好、高性能、AI 兼容" at the upper
      display-md clamp — fit on a single line at lg+ viewports. `text-balance`
      keeps any forced wrap (narrow viewports, longer translations) tidy. */}
  <header class="grid lg:grid-cols-12 gap-x-12 gap-y-5 mb-12 lg:mb-16">
    <div class="lg:col-span-6">
      <span class="mq-eyebrow mb-3 block">{features.eyebrow}</span>
      <h2 class="mq-section-title text-balance">{features.heading}</h2>
    </div>
    <p
      class="lg:col-span-6 lg:col-start-7 self-end text-base lg:text-[1.0625rem] leading-relaxed text-muted-foreground mq-measure"
    >
      {features.lead}
    </p>
  </header>

  {/* Spec sheet — four pillars in a 2×2 grid. No card chrome on purpose:
      the brief bans identical card grids ("same-sized cards with icon +
      heading + text, repeated endlessly"), so this surface earns its
      structure from type weight, whitespace, and a single top rule. */}
  <ol
    class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-12 md:gap-y-14 lg:gap-y-16 border-t border-border pt-10 md:pt-12 lg:pt-14"
  >
    {features.items.map((feature, idx) => {
      const num = String(idx + 1).padStart(2, "0");
      return (
        <li class="grid grid-cols-[auto_1fr] gap-x-5 md:gap-x-7">
          {/* Mono numeral — quiet typographic anchor, no icon */}
          <span
            class="font-mono text-xs tabular-nums text-muted-foreground/70 tracking-[0.18em] pt-1.5"
          >
            {num}
          </span>

          <div class="min-w-0">
            <h3 class="text-lg lg:text-xl font-semibold text-foreground tracking-tight">
              {feature.title}
            </h3>
            <p
              class="mt-3 text-sm lg:text-[0.9375rem] leading-relaxed text-muted-foreground mq-measure"
            >
              {feature.description}
            </p>

            {/* Component list — mirrors the whitepaper's bulleted
                "constituent components" list under each chapter heading.
                Mono font here because most keywords are Latin code
                identifiers (gate names, backends, algorithm acronyms);
                CJK glyphs fall back to the regular sans stack gracefully. */}
            <ul
              class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted-foreground/85"
            >
              {feature.keywords.map((kw, i) => (
                <>
                  <li>{kw}</li>
                  {i < feature.keywords.length - 1 && (
                    <li aria-hidden="true" class="text-muted-foreground/40">·</li>
                  )}
                </>
              ))}
            </ul>
          </div>
        </li>
      );
    })}
  </ol>
</section>
