---
/*
 * Hero — static, single-message. Replaced the previous three-slide
 * autoplay carousel after the impeccable critique (see PRODUCT.md anti-
 * references: dark-mode-with-neon, glassmorphism, AI-startup gradients).
 * Filename preserved to avoid churning imports; treat the "Carousel" in
 * the name as historical.
 *
 * Layout: two-column left-aligned on lg+. Left: eyebrow → headline →
 * description → primary CTA + install-copy button → source-mirror row.
 * Right: persistent Bell-state code panel with "Run in Composer →"
 * footer. Below lg the proof stacks under the CTA row, still visible.
 */
import type { HomeMessages } from "../../locales/home";
import { withBase } from "../../config/urls";
import { CODE_MIRRORS } from "../../config/site";

interface Props {
  hero: HomeMessages["hero"];
  framework: HomeMessages["framework"];
}

const { hero, framework } = Astro.props as Props;
const BASE = import.meta.env.BASE_URL || "/";

function resolveHref(href: string): string {
  return /^https?:\/\//.test(href) ? href : withBase(href, BASE);
}

const ctaHref = resolveHref(hero.ctaHref);
const runHref = resolveHref(hero.runInComposerHref);
---

<section
  class="relative border-b border-border bg-background"
  aria-labelledby="hero-headline"
>
  <div class="mq-container py-16 md:py-20 lg:py-24">
    <div class="grid lg:grid-cols-12 gap-x-10 xl:gap-x-14 gap-y-10 lg:gap-y-0 items-center">
      <div class="lg:col-span-7 min-w-0">
        {hero.eyebrow && (
          <p
            class="mq-eyebrow text-muted-foreground mb-5 mq-animate-in"
            style="--mq-delay: 0ms"
          >
            {hero.eyebrow}
          </p>
        )}
        <h1
          id="hero-headline"
          class="mq-display text-balance mb-5 mq-animate-in"
          style="--mq-delay: 80ms"
        >
          {hero.headline}
        </h1>
        <p
          class="text-lg text-muted-foreground mq-measure mb-8 mq-animate-in"
          style="--mq-delay: 160ms"
        >
          {hero.description}
        </p>

        <div
          class="flex flex-wrap items-center gap-3 mq-animate-in"
          style="--mq-delay: 240ms"
        >
          <a href={ctaHref} class="mq-btn-primary px-6">
            <span>{hero.ctaLabel}</span>
            <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14m-6-6l6 6l-6 6"
              />
            </svg>
          </a>
          <button
            type="button"
            class="mq-btn-run gap-2 font-mono text-sm"
            data-install-copy
            data-copy-text={framework.installCmd}
            data-copied-label={framework.installCopiedLabel}
            data-manual-label={framework.installManualLabel}
            aria-label={`Copy ${framework.installCmd}`}
          >
            <span data-install-label>{framework.installCmd}</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5 opacity-80" viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="M9 2h9a2 2 0 0 1 2 2v13h-2V4H9V2Zm-4 4h9a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm0 2v13h9V8H5Z"
              />
            </svg>
          </button>
        </div>

        <p
          class="mt-8 text-sm text-muted-foreground flex flex-wrap items-center gap-x-1.5 gap-y-1 mq-animate-in"
          style="--mq-delay: 320ms"
        >
          <span class="font-medium text-foreground/70">{hero.mirrorsLabel}</span>
          {CODE_MIRRORS.map((mirror) => (
            <>
              <span aria-hidden="true" class="text-muted-foreground/50">·</span>
              <a
                href={mirror.href}
                target="_blank"
                rel="noopener"
                class="mq-focus-ring rounded-sm text-foreground hover:text-primary transition-colors"
              >
                {mirror.label}
                <span class="sr-only"> {hero.opensInNewTab}</span>
              </a>
            </>
          ))}
        </p>
      </div>

      <aside
        class="lg:col-span-5 min-w-0 mq-animate-in"
        style="--mq-delay: 360ms"
        aria-label={hero.proofAriaLabel}
      >
        <figure class="mq-card overflow-hidden">
          <figcaption class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-secondary/60">
            <span class="text-[11px] font-mono text-muted-foreground tracking-tight">
              {hero.proofTitle}
            </span>
            <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-muted-foreground">
              {hero.proofLang}
            </span>
          </figcaption>
          <pre
            class="overflow-auto p-5 text-[12.5px] leading-[1.7] font-mono text-foreground/90 m-0"
            lang={hero.proofLang}
          ><code>{hero.proofCode}</code></pre>
          <a
            href={runHref}
            class="mq-focus-ring flex items-center justify-between px-4 py-3 border-t border-border text-sm text-foreground hover:bg-secondary/50 hover:text-primary transition-colors"
          >
            <span>{hero.runInComposerLabel}</span>
            <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14m-6-6l6 6l-6 6"
              />
            </svg>
          </a>
        </figure>
      </aside>
    </div>
  </div>
</section>

<script>
  /*
   * Install-copy binding. The same [data-install-copy] selector is used by
   * FrameworkIntro further down the page; both scripts run on load and
   * iterate all matching buttons. The `dataset.copyBound` flag prevents
   * double-binding regardless of script execution order.
   */
  (function () {
    document.querySelectorAll<HTMLButtonElement>("[data-install-copy]").forEach((button) => {
      if (button.dataset.copyBound === "true") return;
      button.dataset.copyBound = "true";

      const text = button.getAttribute("data-copy-text") || "";
      const copiedLabel = button.getAttribute("data-copied-label") || "Copied";
      const manualLabel =
        button.getAttribute("data-manual-label") ||
        "Copy failed \u2014 press \u2318C / Ctrl+C";
      const labelEl = button.querySelector<HTMLElement>("[data-install-label]");
      const originalLabel = labelEl?.textContent || text;

      function flashLabel(label: string, holdMs: number) {
        if (labelEl) labelEl.textContent = label;
        button.classList.remove("mq-flash");
        void button.offsetWidth;
        button.classList.add("mq-flash");
        setTimeout(() => {
          if (labelEl) labelEl.textContent = originalLabel;
          button.classList.remove("mq-flash");
          button.removeAttribute("data-copy-state");
        }, holdMs);
      }

      button.addEventListener("click", async () => {
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) {
            throw new Error("clipboard unavailable");
          }
          await navigator.clipboard.writeText(text);
          button.setAttribute("data-copy-state", "success");
          flashLabel(copiedLabel, 1500);
        } catch (_) {
          button.setAttribute("data-copy-state", "error");
          try {
            const range = document.createRange();
            if (labelEl) range.selectNodeContents(labelEl);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            if (labelEl) sel?.addRange(range);
          } catch (_err) {
            /* selection unavailable */
          }
          flashLabel(manualLabel, 2800);
        }
      });
    });
  })();
</script>
