---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { BenchmarkSection } from "../../locales/benchmark";

interface Props {
  section: BenchmarkSection;
  cpuImage: ImageMetadata;
  gpuImage: ImageMetadata;
  /** Tinted alternative surface for rhythm between consecutive sections. */
  tinted?: boolean;
}

const { section, cpuImage, gpuImage, tinted = false } = Astro.props as Props;
---

<section class:list={[tinted ? "bg-muted/30 border-t border-border" : ""]}>
  <div class="mq-container py-20 lg:py-28">
    {/* Section header — asymmetric, left-weighted. */}
    <div class="grid lg:grid-cols-12 gap-x-12 mb-12 lg:mb-14">
      <div class="lg:col-span-9">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          {section.kicker}
        </p>
        <h2 class="mt-4 text-display-md font-bold text-foreground tracking-tight">
          {section.heading}
        </h2>
        <p class="mt-5 text-base md:text-lg text-muted-foreground leading-relaxed mq-measure">
          {section.lead}
        </p>
      </div>
    </div>

    {/* Two charts side-by-side on lg+, stacked below. */}
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-8">
      <figure class="mq-card overflow-hidden bg-card flex flex-col">
        <div class="p-4 md:p-5 lg:p-6">
          <Image
            src={cpuImage}
            alt={section.cpuAlt}
            class="w-full h-auto"
            loading="lazy"
            densities={[1, 2]}
          />
        </div>
        <figcaption class="px-6 py-5 border-t border-border bg-background/40">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">
            {section.cpuFigLabel}
          </p>
          <p class="mt-2 text-sm text-foreground leading-relaxed">
            {section.cpuCaption}
          </p>
        </figcaption>
      </figure>

      <figure class="mq-card overflow-hidden bg-card flex flex-col">
        <div class="p-4 md:p-5 lg:p-6">
          <Image
            src={gpuImage}
            alt={section.gpuAlt}
            class="w-full h-auto"
            loading="lazy"
            densities={[1, 2]}
          />
        </div>
        <figcaption class="px-6 py-5 border-t border-border bg-background/40">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">
            {section.gpuFigLabel}
          </p>
          <p class="mt-2 text-sm text-foreground leading-relaxed">
            {section.gpuCaption}
          </p>
        </figcaption>
      </figure>
    </div>

    {/* Finding — large display sentence + mono attribution. No border bar,
        no quote chrome. Typography alone carries the weight. */}
    <div class="mt-14 lg:mt-16 max-w-[44ch] lg:max-w-[58ch]">
      <p class="text-2xl md:text-3xl lg:text-[2rem] font-semibold text-foreground leading-[1.2] tracking-tight">
        {section.finding}
      </p>
      {section.findingHref ? (
        <a
          href={section.findingHref}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-foreground mq-focus-ring rounded-sm"
        >
          {section.findingSource}
          <svg aria-hidden="true" class="w-3 h-3" viewBox="0 0 24 24">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 17L17 7M9 7h8v8"
            />
          </svg>
        </a>
      ) : (
        <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          {section.findingSource}
        </p>
      )}
    </div>
  </div>
</section>
