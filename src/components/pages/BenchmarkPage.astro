---
import type { Lang } from "../../config/i18n";
import type { BenchmarkMessages } from "../../locales/benchmark";

import BenchmarkSection from "./BenchmarkSection.astro";
import randomCircuitCpu from "../../assets/benchmark/Random_circuit_CPU.png";
import randomCircuitGpu from "../../assets/benchmark/Random_circuit_GPU.png";
import qaoaCpu from "../../assets/benchmark/QAOA_CPU.png";
import qaoaGpu from "../../assets/benchmark/QAOA_GPU.png";

interface Props {
  lang: Lang;
  messages: BenchmarkMessages;
}

const { messages } = Astro.props as Props;
---

{/* -------------------------------------------------------------------
    HERO — asymmetric. Editorial weight on the left, a mono "spec
    strip" on the right that reads like the header of a technical
    report. No centered stack, no gradient text, no card chrome.
   ------------------------------------------------------------------- */}
<section class="border-b border-border">
  <div class="mq-container pt-16 pb-20 lg:pt-24 lg:pb-28">
    <div class="grid lg:grid-cols-12 gap-x-12 gap-y-12 items-end">
      <div class="lg:col-span-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          {messages.kicker}
        </p>
        <h1 class="mt-6 text-display-xl font-extrabold text-foreground tracking-tight max-w-[18ch]">
          {messages.title}
        </h1>
        <p class="mt-7 text-lg md:text-xl text-muted-foreground leading-relaxed mq-measure">
          {messages.subtitle}
        </p>
      </div>

      <aside class="lg:col-span-4 lg:pl-8 lg:border-l lg:border-border">
        <dl class="space-y-0">
          {messages.summary.map((row, idx) => (
            <div
              class:list={[
                "flex items-baseline justify-between gap-6 py-3",
                idx === 0 ? "" : "border-t border-border",
              ]}
            >
              <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                {row.label}
              </dt>
              <dd class="font-mono text-sm text-foreground tabular-nums text-right">
                {row.value}
              </dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </div>
</section>

{/* -------------------------------------------------------------------
    METHODOLOGY — three columns of definitions. Mono labels keep the
    "engineering manual" voice; values are semibold sans.
   ------------------------------------------------------------------- */}
<section class="mq-container pt-16 lg:pt-20 pb-12 lg:pb-16">
  <h2 class="sr-only">{messages.methodology.heading}</h2>
  <div class="grid md:grid-cols-3 gap-x-12 gap-y-10">
    {messages.methodology.blocks.map((block) => (
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground mb-3">
          {block.label}
        </p>
        <p class="text-foreground text-lg font-semibold tracking-tight leading-snug">
          {block.value}
        </p>
        {block.detail && (
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
            {block.detail}
          </p>
        )}
      </div>
    ))}
  </div>
</section>

{/* -------------------------------------------------------------------
    FRAMEWORKS — dense two-column block. The list reads like a packing
    list: name on the left, version in mono on the right.
   ------------------------------------------------------------------- */}
<section class="border-y border-border bg-muted/40">
  <div class="mq-container py-14 lg:py-20">
    <div class="grid lg:grid-cols-12 gap-x-12 gap-y-10">
      <div class="lg:col-span-4">
        <h2 class="text-2xl md:text-[1.75rem] font-bold text-foreground tracking-tight leading-tight">
          {messages.frameworks.heading}
        </h2>
        <p class="mt-4 text-sm text-muted-foreground leading-relaxed mq-measure">
          {messages.frameworks.lead}
        </p>
      </div>
      <div class="lg:col-span-8">
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
          {messages.frameworks.items.map((fw) => (
            <li class="flex items-baseline justify-between gap-4 py-3 border-b border-border">
              <span
                class:list={[
                  "text-foreground",
                  fw.highlight ? "font-bold" : "font-medium",
                ]}
              >
                {fw.name}
              </span>
              <span class="font-mono text-xs text-muted-foreground tabular-nums">
                {fw.version}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

{/* -------------------------------------------------------------------
    SECTION 01 — Random circuit. Plain background.
   ------------------------------------------------------------------- */}
<BenchmarkSection
  section={messages.randomCircuit}
  cpuImage={randomCircuitCpu}
  gpuImage={randomCircuitGpu}
/>

{/* -------------------------------------------------------------------
    SECTION 02 — QAOA. Tinted surface alternates rhythm with §1.
   ------------------------------------------------------------------- */}
<BenchmarkSection
  section={messages.qaoa}
  cpuImage={qaoaCpu}
  gpuImage={qaoaGpu}
  tinted
/>

{/* -------------------------------------------------------------------
    CTA — paper-footer in spirit. No banner gradient, no card.
   ------------------------------------------------------------------- */}
<section class="border-t border-border">
  <div class="mq-container py-16 lg:py-20">
    <div class="grid lg:grid-cols-12 gap-x-12 gap-y-8 items-end">
      <div class="lg:col-span-7">
        <h2 class="text-display-md font-bold text-foreground tracking-tight">
          {messages.cta.heading}
        </h2>
        <p class="mt-4 text-base md:text-lg text-muted-foreground leading-relaxed mq-measure">
          {messages.cta.lead}
        </p>
      </div>
      <div class="lg:col-span-5 flex flex-wrap gap-3 lg:justify-end">
        <a href={messages.cta.primary.href} class="mq-btn-primary px-6">
          {messages.cta.primary.label}
        </a>
        <a
          href={messages.cta.secondary.href}
          target="_blank"
          rel="noopener"
          class="mq-btn-outline px-6"
        >
          {messages.cta.secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>
